-                build.triplet, build.compiler, build.library, build.version, build.profile
+            println!(
+                "{}",
+                json!({
+                    "triplet": build.triplet,
+                    "compiler": build.compiler,
+                    "library": build.library,
+                    "version": build.version,
+                    "profile": build.profile,
+                    "path": path,
